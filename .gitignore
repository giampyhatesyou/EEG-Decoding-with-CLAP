# ── Editor / IDE ──────────────────────────────────────────────
/.vscode/
/.idea/
*.code-workspace

# ── OS junk ───────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ── Virtual environments ──────────────────────────────────────
.venv/
venv/
env/
# Extracted upstream reference tree (only a leftover .venv lives here).
/Music_attention-main/

# ── Large local-only archives (not distributed through git) ───
/dataset.zip
/Music_attention-main.zip

# ── Assistant / agent config — keep the repo human-authored ───
/CLAUDE.md
/GEMINI.md
/.claude/

# ── Run artifacts: everything a run emits lives under runs/ ───
# runs/results/  per-run CSVs, hparams, checkpoints, tfevents
# runs/logs/     stdout of the launcher scripts
# None of it is source: it is provenance, mirrored read-only into
# Tesi/_baldo_archive_*/ and re-derivable by re-running the sweeps.
# The numbers that go in the thesis are pinned in results_manifest.tsv
# and rendered into RESULTS.md — those two ARE tracked.
/runs/
/lightning_logs/
*.log
# SLURM job stdout: same status as *.log. (A trailing `# comment` on a pattern
# line is NOT a comment in .gitignore -- it becomes part of the pattern.)
*.out
# Pre-2026-07-26 layout, superseded by runs/logs/; a pull leaves it behind.
/logs/
# ...except under docs/provenance/, where a log is not run noise but EVIDENCE: the
# Exp. 17 extraction ran on baldo, in another interpreter, and its integral output is
# the only record of the download, the checkpoint hash and the per-stem frame counts.
!docs/provenance/*.log

# Never commit re-derivable binaries. Paper checkpoints ship as
# archive/*.7z and are unpacked locally by scripts/setup_checkpoints.sh.
*.ckpt
events.out.tfevents.*
