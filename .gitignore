# ===== IDE / editor =====
/.vscode

# ===== Archives kept locally only =====
/dataset.zip
/Music_attention-main.zip

# ===== Python bytecode / caches =====
__pycache__/
*.pyc
*.pyo
*.pyd

# ===== Training artifacts (generated) =====
# Ignore everything under results/ ...
/results/**
# ... EXCEPT baseline runs (explicitly tracked for reproducibility)
!/results/baseline_*/
!/results/baseline_*/**
# But within tracked baseline runs, skip binary tensorboard event files (re-runnable)
/results/baseline_*/events.out.tfevents.*

# Slurm / training logs
/logs/
**/log/log.txt
**/log/*.log
**/log/slurm_*.out
**/log/slurm_*.err

# Checkpoints (large binaries; extract from archive/ via scripts/extract_checkpoints.sh)
/checkpoints/*.ckpt

# ===== Datasets and large binaries =====
/dataset/

# ===== OS junk =====
.DS_Store
**/.DS_Store
Thumbs.db
